{
  "name": "@bal-commons/attachment-ui",
  "version": "0.1.0",
  "description": "Web Components for the commons attachment service: upload cases with typed slots, thumbnails and submission.",
  "license": "Apache-2.0",
  "author": "Hasitha Aravinda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bal-commons/module-commons-attachment.git",
    "directory": "ui"
  },
  "keywords": [
    "web-components",
    "lit",
    "upload",
    "attachments",
    "files",
    "bal-commons",
    "ballerina"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bundle": "./dist/attachment-ui.bundle.js"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/attachment-ui.bundle.js"
  ],
  "customElements": "dist/custom-elements.json",
  "scripts": {
    "build": "vite build && vite build -c vite.bundle.config.ts && tsc -p tsconfig.json --emitDeclarationOnly && cem analyze --litelement --globs 'src/**/*.ts' --outdir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bal-commons/ui-core": "^0.1.0",
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
